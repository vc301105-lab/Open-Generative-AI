    {
      "parameters": {
        "content": "## TLG Error Alerts\nYe workflow **TLG 01** ke Settings → **Error Workflow** me set karo.\n\nJab bhi pipeline hard-crash karega, Telegram pe alert aayega (chat ID `Alert Config` node me bharo + Telegram credential lagao).\n\nChat ID na bhara ho toh workflow chup-chaap log-only mode me khatam ho jata hai.",
        "height": 260,
        "width": 440
      },
      "id": "e0b2c3d4-0001-4e01-9b01-000000000001",
      "name": "Sticky — Error Alerts",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-560, 40]
    },
    {
      "parameters": {},
      "id": "e0b2c3d4-0002-4e02-9b02-000000000002",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [-480, 360]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "alert-tg-chat",
              "name": "telegramChatId",
              "value": "PASTE_TELEGRAM_CHAT_ID_HERE_OR_LEAVE_EMPTY",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "e0b2c3d4-0003-4e03-9b03-000000000003",
      "name": "Alert Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-260, 360]
    },
    {
      "parameters": {
        "jsCode": "const e = $input.first().json;\nreturn [{\n  json: {\n    workflowName: e.workflow?.name || 'unknown',\n    executionUrl: e.execution?.url || '',\n    failedNode: e.execution?.lastNodeExecuted || '',\n    message: String(e.execution?.error?.message || e.execution?.error || 'unknown error').slice(0, 800),\n  },\n}];"
      },
      "id": "e0b2c3d4-0004-4e04-9b04-000000000004",
      "name": "Format Error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-40, 360]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "if-alert-configured",
              "leftValue": "={{ $('Alert Config').first().json.telegramChatId }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "e0b2c3d4-0005-4e05-9b05-000000000005",
      "name": "Alert Configured?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [180, 360]
    },
    {
      "parameters": {
