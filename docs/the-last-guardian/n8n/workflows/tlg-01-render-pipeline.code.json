      "name": "Wait 30s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [2520, 120],
      "webhookId": "f0a1b2c3-aaaa-4d18-9a18-000000000018"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://generativelanguage.googleapis.com/v1beta/{{ $('Check Veo Submit').last().json.opName }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "f0a1b2c3-0019-4d19-9a19-000000000019",
      "name": "Poll Veo Job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2740, 120],
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "if-veo-done",
              "leftValue": "={{ $json.done }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "f0a1b2c3-0020-4d20-9a20-000000000020",
      "name": "Veo Done?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [2960, 120]
    },
    {
      "parameters": {
        "jsCode": "// Veo operation result → video URI ya failReason\nconst out = [];\nfor (const item of $input.all()) {\n  const j = item.json || {};\n  const clipId = $('Build Prompts').last().json.clipId;\n  if (j.error) {\n    out.push({ json: { ok: false, clipId, failReason: 'Veo error: ' + String(j.error.message || JSON.stringify(j.error).slice(0, 300)) } });\n    continue;\n  }\n  const samples = j?.response?.generateVideoResponse?.generatedSamples || [];\n  const uri = samples[0]?.video?.uri;\n  if (uri) {\n    out.push({ json: { ok: true, clipId, videoUri: uri } });\n    continue;\n  }\n  out.push({ json: { ok: false, clipId, failReason: 'Veo returned no video: ' + JSON.stringify(j).slice(0, 300) } });\n}\nreturn out;"
      },
      "id": "f0a1b2c3-0021-4d21-9a21-000000000021",
      "name": "Check Veo Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3200, 0]
    },
