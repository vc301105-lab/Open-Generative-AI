        "jsCode": "// Quota guard: ek run me max N shots hi render karo (Config > maxShotsPerRun)\nconst cfg = $('Config').first().json;\nconst limit = Number(cfg.maxShotsPerRun) || 25;\nreturn $input.all().slice(0, limit);"
