    {
      "parameters": {
        "content": "## 2) Still frame — Gemini\nHar shot ka pehle **still** banta hai (Gemini image model).\n\nAgar still fail ho gaya toh row `FAILED` mark hoti hai aur pipeline agle shot pe chala jata hai — run rukta nahi.",
        "height": 200,
        "width": 560
      },
      "id": "f0a1b2c3-0008-4d08-9a08-000000000008",
      "name": "Sticky — Still (Gemini)",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [680, 100]
    },
    {
      "parameters": {
        "jsCode": "// Sheet row → final image prompt + video prompt\nconst cfg = $('Config').first().json;\nconst out = [];\nfor (const item of $input.all()) {\n  const row = item.json;\n  const videoBase = String(row.video_prompt || row.prompt || '').trim();\n  const stillBase = String(row.prompt || row.video_prompt || '').trim();\n  if (!videoBase) {\n    throw new Error(`Row ${row.clip_id}: prompt / video_prompt column khali hai — sheet me prompt paste karo`);\n  }\n  const imagePrompt = [\n    stillBase,\n    '',\n    cfg.styleSuffix,\n    `Avoid: ${cfg.negativeSuffix}.`,\n  ].join('\\n');\n  const videoPrompt = [\n    videoBase,\n    '',\n    cfg.styleSuffix,\n    `Avoid: ${cfg.negativeSuffix}.`,\n  ].join('\\n');\n  out.push({\n    json: {\n      clipId: String(row.clip_id),\n      scene: row.scene,\n      shot: row.shot,\n      seconds: row.seconds,\n      location: row.location,\n      imagePrompt,\n      videoPrompt,\n    },\n  });\n}\nreturn out;"
      },
      "id": "f0a1b2c3-0009-4d09-9a09-000000000009",
      "name": "Build Prompts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [700, 360]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/{{ $('Config').first().json.geminiImageModel }}:generateContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contents: [{ parts: [{ text: $('Build Prompts').last().json.imagePrompt }] }], generationConfig: { responseModalities: ['IMAGE'] } }) }}",
        "options": {}
      },
      "id": "f0a1b2c3-0010-4d10-9a10-000000000010",
      "name": "Generate Still (Gemini)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [920, 360],
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "// Gemini response → still image (binary) ya failReason\nconst out = [];\nfor (const item of $input.all()) {\n  const row = $('Build Prompts').last().json;\n  const resp = item.json || {};\n  const apiError = resp?.error?.message || resp?.errorMessage;\n  const parts = resp?.candidates?.[0]?.content?.parts || [];\n  const img = parts.find(p => (p.inlineData && p.inlineData.data) || (p.inline_data && p.inline_data.data));\n  if (!img) {\n    out.push({\n      json: {\n        ok: false,\n        clipId: row.clipId,\n        failReason: 'Gemini still failed: ' + String(apiError || JSON.stringify(resp).slice(0, 300)),\n      },\n    });\n    continue;\n  }\n  const b64 = (img.inlineData && img.inlineData.data) || (img.inline_data && img.inline_data.data);\n  const mime = (img.inlineData && img.inlineData.mimeType) || (img.inline_data && img.inline_data.mime_type) || 'image/png';\n  const fileName = `${row.clipId}_still.png`;\n  const binary = await this.helpers.prepareBinaryData(Buffer.from(b64, 'base64'), fileName, mime);\n  out.push({\n    json: { ok: true, clipId: row.clipId, b64, fileName, mime },\n    binary: { data: binary },\n  });\n}\nreturn out;"
      },
      "id": "f0a1b2c3-0011-4d11-9a11-000000000011",
      "name": "Parse Still",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1140, 360]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
