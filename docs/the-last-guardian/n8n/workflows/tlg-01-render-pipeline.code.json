      "name": "Still OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1360, 360]
    },
    {
      "parameters": {
        "content": "## 3) Video — Veo\nStill ko **first frame** banakar Veo job submit hoti hai → har 30s poll → video download.\n\nVeo ke liye Gemini API key pe **billing enable** hona chahiye.",
        "height": 200,
        "width": 620
      },
      "id": "f0a1b2c3-0013-4d13-9a13-000000000013",
      "name": "Sticky — Video (Veo)",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [1620, -160]
    },
    {
      "parameters": {
        "name": "={{ $('Parse Still').last().json.fileName }}",
        "folderId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $('Config').first().json.stillsFolderId }}"
        },
        "inputFieldName": "data",
        "options": {}
      },
      "id": "f0a1b2c3-0014-4d14-9a14-000000000014",
      "name": "Upload Still",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [1640, 240]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/{{ $('Config').first().json.veoModel }}:predictLongRunning",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ instances: [{ prompt: $('Build Prompts').last().json.videoPrompt, image: { bytesBase64Encoded: $('Parse Still').last().json.b64 } }], parameters: { aspectRatio: '16:9', numberOfVideos: 1, personGeneration: 'allow_adult', negativePrompt: $('Config').first().json.negativeSuffix } }) }}",
        "options": {}
      },
      "id": "f0a1b2c3-0015-4d15-9a15-000000000015",
      "name": "Submit Veo Job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1860, 240],
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 10000
    },
    {
      "parameters": {
        "jsCode": "// Veo submit response → operation name ya failReason\nconst out = [];\nfor (const item of $input.all()) {\n  const j = item.json || {};\n  if (j.name) {\n    out.push({ json: { ok: true, opName: j.name } });\n  } else {\n    out.push({\n      json: {\n        ok: false,\n        clipId: $('Build Prompts').last().json.clipId,\n        failReason: 'Veo submit failed: ' + String(j?.error?.message || JSON.stringify(j).slice(0, 300)),\n      },\n    });\n  }\n}\nreturn out;"
      },
      "id": "f0a1b2c3-0016-4d16-9a16-000000000016",
      "name": "Check Veo Submit",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
