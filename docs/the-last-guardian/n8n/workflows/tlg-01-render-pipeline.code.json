    {
      "parameters": {
        "content": "## 4) Save + Status\nDrive me still + clip upload → Sheet me `DONE` / `FAILED` update → loop agla shot uthata hai.\n\nEnd me optional Telegram summary (Config me `telegramChatId` bharo + Telegram credential lagao).",
        "height": 220,
        "width": 560
      },
      "id": "f0a1b2c3-0027-4d27-9a27-000000000027",
      "name": "Sticky — Save + Summary",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [3860, -420]
    },
    {
      "parameters": {
        "jsCode": "// Run summary — kitne DONE, kitne FAILED\nfunction count(name) {\n  try { return $(name).all().length; } catch (e) { return 0; }\n}\nreturn [{\n  json: {\n    done: count('Mark DONE'),\n    failed: count('Mark FAILED'),\n    at: $now.toISO(),\n  },\n}];"
      },
